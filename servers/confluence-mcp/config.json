{
  "id": "mcp-confluence",
  "name": "Confluence MCP",
  "version": "1.0.0",
  "description": "Confluence wiki server. Page CRUD, space management, search, and content retrieval.",
  "source": "community",
  "transport": "stdio",
  "command": "npx",
  "args": ["-y", "confluence-mcp"],
  "publishStatus": "published",
  "tags": ["documentation", "wiki", "knowledge"],
  "tools": [
    { "name": "search_pages", "description": "Search Confluence pages with CQL", "category": "search", "accessLevel": "allowed" },
    { "name": "get_page", "description": "Get page content", "category": "read", "accessLevel": "allowed" },
    { "name": "create_page", "description": "Create a new page", "category": "write", "accessLevel": "allowed" },
    { "name": "update_page", "description": "Update page content", "category": "write", "accessLevel": "allowed" }
  ],
  "envVars": [
    { "name": "CONFLUENCE_BASE_URL", "required": true, "secret": false, "description": "Confluence base URL" },
    { "name": "CONFLUENCE_USER_EMAIL", "required": true, "secret": false, "description": "Confluence user email" },
    { "name": "CONFLUENCE_API_KEY", "required": true, "secret": true, "description": "Confluence API key" }
  ],
  "changelog": [
    { "version": "1.0.0", "date": "2026-03-20", "notes": "Initial Confluence MCP with CQL search and page management." }
  ]
}
